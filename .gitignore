.superpowers/
# No trailing slash: a worktree's node_modules is a symlink, not a directory,
# and `node_modules/` matches directories only — which is how one got committed.
node_modules
.playwright-mcp/

# Claude Code: ignore machine-local config and generated review artifacts,
# but allow shared project config (.claude/settings.json) to be committed.
.claude/*
!.claude/settings.json

# Material comercial: contém CPF, endereço e chave PIX, além do contrato
# preenchido com dados da contratante. Fica fora do versionamento — este
# repositório alimenta releases públicas e um dia pode virar público.
docs/comercial/

# Cache do ruff (gerado ao rodar lint nos scripts Python de docs/)
.ruff_cache/

# Estado local do wrangler (cache de build e sessao), gerado ao rodar
# `wrangler deploy`/`dev` em infra/update-proxy.
.wrangler/
