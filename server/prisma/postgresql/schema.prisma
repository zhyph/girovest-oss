// GENERATED FILE — do not edit directly. Edit prisma/models.prisma
// and run `npm run db:schema` instead.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String   @id @default(uuid())
  name      String
  address   String
  locale    String   @default("pt-BR")
  phone     String?
  createdAt DateTime @default(now())

  /// Days a piece stays unavailable after it comes back, for cleaning and
  /// repairs, before it can go out to the next customer. 0 keeps the original
  /// behaviour: free again the day after the return.
  maintenanceBufferDays Int @default(0)

  /// "lan" (today's LAN-direct QR flow, unchanged) or "relay" (routes signing
  /// and photo sessions through the Cloudflare relay for shops with no shared
  /// Wi-Fi). Defaults to "lan" so existing installs see zero behavior change
  /// after upgrading — only a fresh install's setup wizard offers "relay" as
  /// its own default. See docs/superpowers/specs/2026-07-29-no-shared-wifi-relay-design.md.
  connectivityMode String @default("lan")

  staff                Staff[]
  products             Product[]
  clients              Client[]
  contracts            Contract[]
  contractClauses      LocationContractClause[]
  productPhotoTokens   ProductPhotoToken[]
}

model Staff {
  id           String   @id @default(uuid())
  name         String
  login        String   @unique
  passwordHash String
  role         String
  locationId   String
  createdAt    DateTime @default(now())

  /// bcrypt hash of the current recovery code (see auth/recoveryCodes.ts),
  /// never the plaintext. Nullable: accounts created before this feature
  /// existed have none until they next reset, at which point one is minted.
  /// Rotated (replaced) on every successful use of "Esqueci minha senha",
  /// same reasoning as 2FA backup codes: a code that still works after
  /// someone has read it once is a standing risk, not a convenience.
  recoveryCodeHash String?

  /// The `issuedAt` of the last support-issued password-reset ticket
  /// (passwordResetTickets.ts) actually consumed for this account. A ticket
  /// whose issuedAt is <= this value is rejected -- otherwise the same
  /// approved ticket could reset the password an unlimited number of times
  /// within its freshness window, since nothing else marks it as spent.
  lastResetTicketIssuedAt DateTime?

  location              Location     @relation(fields: [locationId], references: [id])
  allocations           Allocation[]
  contracts             Contract[]
  productPhotoTokens    ProductPhotoToken[]
}

model Client {
  id         String   @id @default(uuid())
  locationId String
  name       String
  phone      String
  email      String
  notes      String?
  createdAt  DateTime @default(now())

  location          Location                 @relation(fields: [locationId], references: [id])
  allocations       Allocation[]
  identityDocuments ClientIdentityDocument[]
  addressLines      ClientAddressLine[]
  contracts         Contract[]
}

model Product {
  id            String   @id @default(uuid())
  locationId    String
  /// Short per-shop reference the staff say out loud ("peça 38"), assigned
  /// sequentially exactly like Contract.number. Nullable only so the column
  /// could be added to shops that already had a catalogue: every piece gets
  /// one at creation, and productBackfill fills the pre-existing rows at
  /// startup. Treat a null as "not backfilled yet", never as "has no code".
  code          Int?
  name          String
  description   String?
  category      String
  size          String
  color         String
  rentalPrice   Float
  depositAmount Float
  photos        String   @default("[]")
  status        String   @default("active")
  createdAt     DateTime @default(now())

  location    Location     @relation(fields: [locationId], references: [id])
  allocations Allocation[]

  @@unique([locationId, code])
}

model Allocation {
  id                 String    @id @default(uuid())
  productId          String
  clientId           String
  staffId            String
  contractId         String?
  checkoutDate       DateTime
  actualCheckoutDate DateTime?
  dueDate            DateTime
  actualReturnDate   DateTime?
  status             String
  priceCharged       Float
  depositCollected   Float?
  depositReturned    Float?
  conditionNotesOut  String?
  conditionNotesIn   String?
  createdAt          DateTime  @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  client   Client    @relation(fields: [clientId], references: [id])
  staff    Staff     @relation(fields: [staffId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])
}

model Contract {
  id              String    @id @default(uuid())
  number          Int
  locationId      String
  clientId        String
  staffId         String
  eventDate       DateTime
  paymentMethod   String
  signatureStatus String    @default("unsigned")
  signatureImage  String?
  signedAt        DateTime?
  createdAt       DateTime  @default(now())

  location     Location      @relation(fields: [locationId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  staff        Staff         @relation(fields: [staffId], references: [id])
  allocations  Allocation[]
  // Vestigial: no longer written by the app (see Payment below). Kept
  // declared, table intact and undropped, purely so paymentBackfill.ts can
  // still read it through Prisma on an install that hasn't run that backfill
  // yet — same reasoning Allocation.contractId stayed nullable rather than
  // ever being hardened to required.
  installments Installment[]
  payments      Payment[]
  signingTokens SigningToken[]

  @@unique([locationId, number])
}

model Payment {
  id         String   @id @default(uuid())
  contractId String
  amount     Float
  /** Freeform, same locale-configured list as Contract.paymentMethod — what this particular payment actually used. */
  method     String
  /** When it was actually paid — she can date it in the past (collected it yesterday, logging it today) or edit it after the fact. */
  paidAt     DateTime
  createdAt  DateTime @default(now())
  /**
   * Who recorded it. Nullable because every payment written before this
   * column existed has no answer, and the shop-PC migration runner has no
   * transactions — additive, nullable columns only. Treat a null as
   * "recorded before we tracked it", never as "nobody".
   */
  /*
   * A plain column, deliberately NOT a Prisma relation.
   *
   * Declaring `recordedBy Staff?` adds a foreign key, and Prisma implements
   * that on SQLite as RedefineTables: create new_Payment, copy, DROP TABLE
   * Payment, rename. The shop-PC migration runner has no transactions, so a
   * crash in that window destroys the payment ledger outright. As a bare
   * nullable column this is one ALTER TABLE ADD COLUMN, which cannot lose
   * anything. Joined in application code where it is needed.
   */
  recordedByStaffId String?
  /**
   * One-per-dialog-open id, unique so a resubmitted request collapses onto
   * the row it already created instead of taking the money twice.
   *
   * The dialog prefills the full outstanding balance, so two people acting on
   * one contract — or one person whose first Salvar appeared to hang — was
   * the DEFAULT path to a duplicate, not a rare interleaving. Nullable for
   * the same reason as above, and because a client that does not send one
   * simply gets the old behaviour.
   */
  clientRequestId String? @unique

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model SigningToken {
  id         String    @id @default(uuid())
  token      String    @unique
  contractId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ProductPhotoToken {
  id         String   @id @default(uuid())
  token      String   @unique
  staffId    String
  locationId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model RelayIdempotencyKey {
  id           String   @id @default(uuid())
  key          String   @unique
  sessionToken String
  createdAt    DateTime @default(now())
}

/**
 * Superseded by Payment: a fixed pre-set schedule didn't match how payments
 * actually arrive (any amount, any time). Left declared rather than dropped
 * — see paymentBackfill.ts, which converts every `paid` row here into a
 * Payment once and empties the table; nothing in the app writes to it
 * anymore.
 */
model Installment {
  id         String    @id @default(uuid())
  contractId String
  dueDate    DateTime
  amount     Float
  paid       Boolean   @default(false)
  paidAt     DateTime?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model LocationContractClause {
  id         String @id @default(uuid())
  locationId String
  sortOrder  Int
  text       String

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model ClientIdentityDocument {
  id       String  @id @default(uuid())
  clientId String
  label    String
  value    String
  maskKey  String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientAddressLine {
  id        String  @id @default(uuid())
  clientId  String
  label     String
  value     String
  sortOrder Int
  maskKey   String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
