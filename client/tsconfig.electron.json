{
  // Separate from tsconfig.json, which is the renderer's. Merging the two would
  // be worse than checking nothing: the main process would compile with
  // `lib: DOM` and the compiler would happily accept `window`, `document` or
  // `localStorage` in code that runs under Node — precisely the mistake a
  // typecheck exists to catch. The renderer would gain Node globals in the
  // other direction.
  //
  // Until this file existed, nothing in electron/ went through tsc at all:
  // tsconfig.json includes only ["src"], and electron-vite merely strips types
  // with esbuild without checking them. The whole main process (main.ts,
  // preload.ts, updater.ts, installId.ts, backup.ts) was unchecked code.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Code in electron/ imports with the extension (`./backup.ts`), which is
    // what electron-vite expects; without this flag every import errors.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // No "vite/client": the main process has no Vite import.meta.env. The
    // constants injected by `define` are declared by hand in updater.ts.
    "types": ["node"]
  },
  "include": ["electron"]
}
