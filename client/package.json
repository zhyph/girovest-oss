{
  "name": "girovest-client",
  "private": true,
  "version": "0.14.1",
  "description": "Girovest desktop and web client — clients, products, allocations, and calendar for a dress rental shop.",
  "author": "Girovest",
  "type": "module",
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhyph/girovest.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "rebuild-server-natives": "electron-rebuild --force --module-dir ../server --which-module better-sqlite3,bcrypt",
    "bundle-server": "cd ../server && npm run build:electron-bundle",
    "prepackage": "npm run bundle-server && npm run rebuild-server-natives",
    "package": "electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "adm-zip": "^0.5.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-big-calendar": "^1.20.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-i18next": "^17.0.10",
    "react-router": "^8.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.10",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
